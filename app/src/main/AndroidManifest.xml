<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ============ USB Host ============ -->
    <!-- USB 访问本身只需要运行时 UsbManager 授权，不需要声明 android.permission -->
    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="false" />

    <!--
      ============ CAMERA（UVC 设备的硬性要求） ============
      从 Android 较新版本起，系统对 USB Video Class(UVC) 设备做了保护：
      调用 UsbManager.requestPermission 时若未持有 CAMERA 权限，
      系统不弹授权框、立即返回拒绝（结果 intent 的 extras 为空）。
      官方 External USB cameras 文档明确：直接访问 USB 设备的 webcam 应用
      必须和普通相机应用一样持有 CAMERA 权限。
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- 外接 USB 摄像头；required=false 保证无摄像头设备（部分车机）也能安装 -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.external"
        android:required="false" />

    <!-- ============ 前台服务（后台保活） ============ -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- targetSdk=33：使用 connectedDevice 类型；该权限在 API34 引入，声明在低版本系统上无效但无害 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Android 13+ 前台服务通知（用户可拒绝，不影响 connectedDevice 取流） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- ============ 存储权限（按版本分支，运行时再做守卫） ============ -->
    <!-- 私有目录（filesDir/MediaStore 之外的 app-specific 目录）不需要任何存储权限 -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- Android 13+ 仅在需要写入公共媒体库时申请，当前默认私有目录存储，属预留 -->
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />

    <!-- ============ GPS 定位（总录像轨迹记录，运行时再申请；车机无 GPS 自动跳过） ============ -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />
    <!-- 回看页在线地图瓦片（离线时自动回退内置示意图，不影响主功能） -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".UvcApp"
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:requestLegacyExternalStorage="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.UvcBlindCam"
        tools:targetApi="29">

        <!-- 注意：configChanges 不包含 uiMode，系统切换深色/浅色时让 Activity 自动
             recreate，使"跟随系统"主题在主界面实时生效（常驻状态机保证画面自动恢复） -->
        <activity
            android:name=".ui.main.MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- USB 插入时允许系统直接拉起 APP -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/usb_device_filter" />
        </activity>

        <!-- 高德地图 API Key（仅用免费测试能力） -->
        <meta-data
            android:name="com.amap.api.v2.apikey"
            android:value="6533b39bf5df2a04a3e559c0415732f7" />

        <!-- 前台保活服务：类型 connectedDevice（USB 外设），不声明 camera 类型以避免强制 CAMERA 权限 -->
        <service
            android:name=".service.UvcForegroundService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- 内置相册：查看照片 / 分录像 / 总录像 -->
        <activity
            android:name=".ui.gallery.GalleryActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/Theme.UvcBlindCam" />

        <!-- 内置照片查看器（全屏缩放，不调系统看图器） -->
        <activity
            android:name=".ui.viewer.PhotoViewerActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/Theme.UvcBlindCam" />

        <!-- 内置视频播放器（自带控件 + 自动收起，不调系统播放器） -->
        <activity
            android:name=".ui.viewer.VideoPlayerActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/Theme.UvcBlindCam" />

        <!-- 录像回看页（时间轴 + 多路预览 + 轨迹地图） -->
        <activity
            android:name=".ui.playback.PlaybackActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/Theme.UvcBlindCam" />

        <!-- 独立设置页 -->
        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/Theme.UvcBlindCam" />

        <!-- 把私有目录的照片/录像授权给系统查看器打开 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
