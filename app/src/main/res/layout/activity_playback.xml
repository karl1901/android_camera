<?xml version="1.0" encoding="utf-8"?>
<!-- 录像回看页：顶部多路预览（总录像合成）+ 时间轴 + 按钮，下方行车轨迹地图；
     一屏优先显示，超出可上下滚动。 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:colorBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 顶部栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/appBar"
            android:elevation="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp">

            <ImageButton
                android:id="@+id/btnBack"
                style="@style/BlindCam.ToolButton"
                android:contentDescription="@string/common_back"
                android:src="@drawable/ic_back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/playback_title"
                android:textColor="?attr/colorOnSurface"
                android:textSize="18sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/btnDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip"
                android:paddingStart="14dp"
                android:paddingTop="8dp"
                android:paddingEnd="14dp"
                android:paddingBottom="8dp"
                android:text="今日"
                android:textColor="?attr/colorPrimary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnCell"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_chip"
                android:paddingStart="14dp"
                android:paddingTop="8dp"
                android:paddingEnd="14dp"
                android:paddingBottom="8dp"
                android:text="@string/playback_all_cells"
                android:textColor="?attr/colorPrimary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnFullscreen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_chip"
                android:paddingStart="14dp"
                android:paddingTop="8dp"
                android:paddingEnd="14dp"
                android:paddingBottom="8dp"
                android:text="@string/playback_fullscreen"
                android:textColor="?attr/colorPrimary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 16:9 预览区 -->
        <com.wheeltech.blindcam.ui.playback.AspectFrameLayout
            android:id="@+id/videoContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FF000000">

            <TextureView
                android:id="@+id/playbackView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- 无录像段提示 -->
            <TextView
                android:id="@+id/tvGap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:padding="20dp"
                android:text="@string/playback_no_content"
                android:textColor="#FFE6EAF0"
                android:textSize="18sp"
                android:visibility="gone" />

            <!-- 左上角当前画面名 -->
            <TextView
                android:id="@+id/tvCellName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="12dp"
                android:background="#99000000"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:text=""
                android:textColor="#FFFFFFFF"
                android:textSize="14sp" />

            <!-- 中央播放按钮 -->
            <ImageButton
                android:id="@+id/btnCenterPlay"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="center"
                android:background="#66000000"
                android:contentDescription="@string/player_play"
                android:src="@drawable/ic_play" />
        </com.wheeltech.blindcam.ui.playback.AspectFrameLayout>

        <!-- 时间轴 + 播放控制 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/appBar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp">

            <ImageButton
                android:id="@+id/btnRewind"
                style="@style/BlindCam.ToolButton"
                android:contentDescription="@string/player_rewind"
                android:src="@drawable/ic_rewind" />

            <ImageButton
                android:id="@+id/btnPlayPause"
                style="@style/BlindCam.ToolButton"
                android:contentDescription="@string/player_play"
                android:src="@drawable/ic_pause" />

            <ImageButton
                android:id="@+id/btnForward"
                style="@style/BlindCam.ToolButton"
                android:contentDescription="@string/player_forward"
                android:src="@drawable/ic_forward" />

            <TextView
                android:id="@+id/tvCurrent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="00:00:00"
                android:textColor="?attr/colorOnSurface"
                android:textSize="12sp" />

            <com.wheeltech.blindcam.ui.playback.TimelineView
                android:id="@+id/timeline"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:minHeight="44dp" />

            <TextView
                android:id="@+id/tvRangeEnd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00:00"
                android:textColor="?attr/onSurfaceDim"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 地图组件 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/playback_map_title"
                android:textColor="?attr/colorPrimary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvMapHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/playback_map_hint"
                android:textColor="?attr/onSurfaceDim"
                android:textSize="12sp" />

            <WebView
                android:id="@+id/mapView"
                android:layout_width="match_parent"
                android:layout_height="280dp"
                android:layout_marginTop="8dp"
                android:background="#FF0E141C" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
