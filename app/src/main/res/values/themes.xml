<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ============================================================
         基础主题：跟随系统（DayNight）。浅色值在此，深色值在 values-night。
         选中“跟随系统”时使用本主题。
         ============================================================ -->
    <style name="Theme.UvcBlindCam" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_blue</item>
        <item name="colorPrimaryDark">@color/brand_blue_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/brand_blue</item>
        <item name="android:colorBackground">#FFF2F4F7</item>
        <item name="colorOnBackground">#FF1A1F26</item>
        <item name="colorSurface">#FFFFFFFF</item>
        <item name="colorOnSurface">#FF1A1F26</item>
        <item name="colorSurfaceVariant">#FFE3EAF2</item>
        <item name="colorOnSurfaceVariant">#FF5A6472</item>
        <item name="colorOutline">#FFB6C0CC</item>
        <item name="android:statusBarColor">#FFFFFFFF</item>
        <item name="android:navigationBarColor">#FFFFFFFF</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowFullscreen">false</item>

        <!-- 自定义属性 -->
        <item name="appBar">#FFFFFFFF</item>
        <item name="chipBg">#FFE3EAF2</item>
        <item name="onSurfaceDim">#FF5A6472</item>
        <item name="dividerColor">#FFD7DDE5</item>
        <item name="btnOutline">#FFB6C0CC</item>
        <item name="previewLabel">#FFFFFFFF</item>
        <item name="accentColor">#FF1565C0</item>
    </style>

