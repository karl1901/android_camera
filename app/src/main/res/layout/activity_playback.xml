<?xml version="1.0" encoding="utf-8"?>
<!-- 录像回看页：顶部多路预览（总录像合成）+ 时间轴 + 按钮，下方高德地图轨迹；
     深色玻璃拟态；一屏优先显示，超出可上下滚动。 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/appBg"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 顶部栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/barBg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/ui_top_bar_pad_h"
            android:paddingTop="@dimen/ui_top_bar_pad_v"
            android:paddingEnd="@dimen/ui_top_bar_pad_h"
            android:paddingBottom="@dimen/ui_top_bar_pad_v">

            <ImageButton
                android:id="@+id/btnBack"
                style="@style/BlindCam.BackButton" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ui_pill_pad_h"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/playback_title"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/ui_bar_title" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/btnDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/barChipBg"
                android:paddingStart="@dimen/ui_pill_pad_h"
                android:paddingTop="@dimen/ui_pill_pad_v"
                android:paddingEnd="@dimen/ui_pill_pad_h"
                android:paddingBottom="@dimen/ui_pill_pad_v"
                android:text="今日"
                android:textColor="?attr/previewLabel"
                android:textSize="@dimen/ui_pill_text" />

            <TextView
                android:id="@+id/btnCell"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ui_pill_pad_h"
                android:background="?attr/barChipBg"
                android:paddingStart="@dimen/ui_pill_pad_h"
                android:paddingTop="@dimen/ui_pill_pad_v"
                android:paddingEnd="@dimen/ui_pill_pad_h"
                android:paddingBottom="@dimen/ui_pill_pad_v"
                android:text="@string/playback_all_cells"
                android:textColor="?attr/previewLabel"
                android:textSize="@dimen/ui_pill_text" />

            <TextView
                android:id="@+id/btnFullscreen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ui_pill_pad_h"
                android:background="?attr/pillSelectedBg"
                android:paddingStart="@dimen/ui_pill_pad_h"
                android:paddingTop="@dimen/ui_pill_pad_v"
                android:paddingEnd="@dimen/ui_pill_pad_h"
                android:paddingBottom="@dimen/ui_pill_pad_v"
                android:text="@string/playback_fullscreen"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/ui_pill_text" />
        </LinearLayout>

        <!-- 16:9 预览区 -->
        <com.wheeltech.blindcam.ui.playback.AspectFrameLayout
            android:id="@+id/videoContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FF000000">

            <GridLayout
                android:id="@+id/videoGrid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:columnCount="2"
                android:rowCount="2" />

            <!-- 空日期黑色遮罩：不锁 Surface，避免与 MediaPlayer 抢生产者导致后续日期黑屏 -->
            <View
                android:id="@+id/blackOverlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#FF000000"
                android:visibility="gone" />

            <!-- 无录像段提示 -->
            <TextView
                android:id="@+id/tvGap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:padding="20dp"
                android:text="@string/playback_no_content"
                android:textColor="#FFFFFFFF"
                android:textSize="@dimen/ui_body"
                android:visibility="gone" />

            <!-- 左上角当前画面名 -->
            <TextView
                android:id="@+id/tvCellName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="12dp"
                android:background="@drawable/bg_pill"
                android:paddingStart="12dp"
                android:paddingTop="5dp"
                android:paddingEnd="12dp"
                android:paddingBottom="5dp"
                android:text=""
                android:textColor="#FFFFFFFF"
                android:textSize="@dimen/ui_panel_pill_text" />

            <!-- 中央播放按钮 -->
            <TextView
                android:id="@+id/btnCenterPlay"
                android:layout_width="@dimen/ui_center_play"
                android:layout_height="@dimen/ui_center_play"
                android:layout_gravity="center"
                android:background="@drawable/bg_play_badge"
                android:gravity="center"
                android:contentDescription="@string/player_play"
                android:text="▶"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/ui_card_title" />
        </com.wheeltech.blindcam.ui.playback.AspectFrameLayout>

        <!-- 时间轴 + 播放控制 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/barBg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/ui_top_bar_pad_h"
            android:paddingTop="@dimen/ui_top_bar_pad_v"
            android:paddingEnd="@dimen/ui_top_bar_pad_h"
            android:paddingBottom="@dimen/ui_top_bar_pad_v">

            <ImageButton
                android:id="@+id/btnRewind"
                android:layout_width="@dimen/ui_player_button"
                android:layout_height="@dimen/ui_player_button"
                android:background="@drawable/bg_play_badge"
                android:contentDescription="@string/player_rewind"
                android:padding="@dimen/ui_tool_padding"
                android:src="@drawable/ic_rewind"
                android:tint="#FFFFFF" />

            <ImageButton
                android:id="@+id/btnPlayPause"
                android:layout_width="@dimen/ui_player_button"
                android:layout_height="@dimen/ui_player_button"
                android:layout_marginStart="@dimen/ui_pill_pad_v"
                android:background="@drawable/bg_play_badge"
                android:contentDescription="@string/player_play"
                android:padding="@dimen/ui_tool_padding"
                android:src="@drawable/ic_play"
                android:tint="#FFFFFF" />

            <ImageButton
                android:id="@+id/btnForward"
                android:layout_width="@dimen/ui_player_button"
                android:layout_height="@dimen/ui_player_button"
                android:layout_marginStart="@dimen/ui_pill_pad_v"
                android:background="@drawable/bg_play_badge"
                android:contentDescription="@string/player_forward"
                android:padding="@dimen/ui_tool_padding"
                android:src="@drawable/ic_forward"
                android:tint="#FFFFFF" />

            <TextView
                android:id="@+id/tvCurrent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ui_pill_pad_v"
                android:text="00:00:00"
                android:textColor="#ECEAF2"
                android:textSize="@dimen/ui_small" />

            <SeekBar
                android:id="@+id/seekBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ui_pill_pad_v"
                android:layout_marginEnd="@dimen/ui_pill_pad_v"
                android:layout_weight="1"
                android:progressTint="?attr/colorPrimary"
                android:progressBackgroundTint="?attr/dividerColor"
                android:thumbTint="?attr/colorPrimary" />

            <TextView
                android:id="@+id/tvRangeEnd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00:00"
                android:textColor="#B9B3CC"
                android:textSize="@dimen/ui_small" />
        </LinearLayout>

        <!-- 高德地图组件 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/ui_page_pad_h"
            android:paddingTop="@dimen/ui_page_pad_v"
            android:paddingEnd="@dimen/ui_page_pad_h"
            android:paddingBottom="@dimen/ui_page_pad_v">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/playback_map_title"
                android:textColor="?attr/colorOnSurface"
                android:textSize="@dimen/ui_card_title"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvMapHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/playback_map_hint"
                android:textColor="?attr/onSurfaceDim"
                android:textSize="@dimen/ui_small" />

            <com.amap.api.maps.MapView
                android:id="@+id/mapView"
                android:layout_width="match_parent"
                android:layout_height="@dimen/ui_map_height"
                android:layout_marginTop="@dimen/ui_pill_pad_v" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>




