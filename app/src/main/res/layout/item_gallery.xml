<?xml version="1.0" encoding="utf-8"?>
<!--
  相册卡片（深色玻璃）：
  - 封面（缩略图）铺满顶部，视频右上角时长 + 中央播放角标
  - 底部：设备名（自定义名优先）+ 时间
  - 多选时右上角勾选框（普通态隐藏）
  - 整卡可点（封面/名称/时间任意处都触发）
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/ui_gallery_gap"
    android:background="?attr/cardBg"
    android:orientation="vertical"
    android:padding="@dimen/ui_gallery_pad">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/imgThumb"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_margin="2dp"
            android:background="@drawable/bg_thumb_round"
            android:clipToOutline="true"
            android:contentDescription="@string/gallery_thumb_desc"
            android:scaleType="centerCrop" />

        <!-- 视频中央播放角标 -->
        <ImageView
            android:id="@+id/imgPlay"
            android:layout_width="@dimen/ui_capture_button"
            android:layout_height="@dimen/ui_capture_button"
            android:layout_gravity="center"
            android:background="@drawable/bg_play_badge"
            android:contentDescription="@string/player_play"
            android:padding="@dimen/ui_capture_padding"
            android:src="@drawable/ic_play"
            android:visibility="gone" />

        <!-- 视频时长 -->
        <TextView
            android:id="@+id/tvDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="6dp"
            android:background="#99000000"
            android:paddingStart="7dp"
            android:paddingTop="3dp"
            android:paddingEnd="7dp"
            android:paddingBottom="3dp"
            android:textColor="#FFFFFFFF"
            android:textSize="@dimen/ui_small"
            android:visibility="gone" />

        <!-- 多选勾选框 -->
        <ImageView
            android:id="@+id/imgCheck"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="top|end"
            android:layout_margin="6dp"
            android:contentDescription="@string/gallery_select_items"
            android:padding="6dp"
            android:scaleType="centerInside"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:textColor="?attr/colorOnSurface"
        android:textSize="@dimen/ui_gallery_name"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingBottom="2dp"
        android:textColor="?attr/onSurfaceDim"
        android:textSize="@dimen/ui_gallery_time" />
</LinearLayout>

