<?xml version="1.0" encoding="utf-8"?>
<!-- 内置照片查看器：全屏黑底 + 可缩放图片 + 顶部返回/名称（点击图片切换显隐） -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <com.wheeltech.blindcam.ui.viewer.ZoomableImageView
        android:id="@+id/photoView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/gallery_thumb_desc" />

    <!-- 顶部栏 -->
    <LinearLayout
        android:id="@+id/barTop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#99000000"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/ui_top_bar_pad_h"
        android:paddingEnd="@dimen/ui_top_bar_pad_h"
        android:paddingTop="@dimen/ui_top_bar_pad_v"
        android:paddingBottom="@dimen/ui_top_bar_pad_v">

        <ImageButton
            android:id="@+id/btnBack"
            style="@style/BlindCam.BackButton" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="6dp">

            <TextView
                android:id="@+id/tvName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/ui_card_title"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="#CCFFFFFF"
                android:textSize="@dimen/ui_small" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
