<?xml version="1.0" encoding="utf-8"?>
<!--
  主界面（横屏车机，深色玻璃拟态，适配多种屏幕）
  - 顶部工具栏（全屏时隐藏）：一键授权 / 刷新 / 布局 / 设置 / 相册 / 总录像 / 全屏
  - 中部：GridLayout 动态 1/2/3/4 宫格预览，面板由代码动态加入
  - 底部设备栏（全屏时隐藏）：已连接摄像头与授权状态，可点未授权项手动授权
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_dark"
    android:orientation="vertical">

    <!-- ============ 顶部工具栏 ============ -->
    <LinearLayout
        android:id="@+id/barTop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_glass_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_title"
            android:textColor="#FFFFFF"
            android:textSize="19sp" />

        <ImageButton
            android:id="@+id/btnGrant"
            style="@style/BlindCam.ToolButton"
            android:background="@drawable/bg_play_badge"
            android:contentDescription="@string/btn_grant_all"
            android:tint="#FFFFFF"
            android:src="@drawable/ic_key" />

        <ImageButton
            android:id="@+id/btnRefresh"
            style="@style/BlindCam.ToolButton"
            android:background="@drawable/bg_play_badge"
            android:contentDescription="@string/btn_refresh"
            android:tint="#FFFFFF"
            android:src="@drawable/ic_refresh" />

        <ImageButton
            android:id="@+id/btnLayout"
            style="@style/BlindCam.ToolButton"
            android:background="@drawable/bg_play_badge"
            android:contentDescription="@string/btn_layout"
            android:tint="#FFFFFF"
            android:src="@drawable/ic_layout" />

        <ImageButton
            android:id="@+id/btnSettings"
            style="@style/BlindCam.ToolButton"
            android:background="@drawable/bg_play_badge"
            android:contentDescription="@string/btn_settings"
            android:tint="#FFFFFF"
            android:src="@drawable/ic_settings" />

        <ImageButton
            android:id="@+id/btnGallery"
            style="@style/BlindCam.ToolButton"
            android:background="@drawable/bg_play_badge"
            android:contentDescription="@string/btn_gallery"
            android:tint="#FFFFFF"
            android:src="@drawable/ic_gallery" />

        <ImageButton
            android:id="@+id/btnRecordAll"
            style="@style/BlindCam.ToolButton"
            android:background="@drawable/bg_play_badge"
            android:contentDescription="@string/btn_record_all"
            android:tint="#FFFFFF"
            android:src="@drawable/ic_videocam" />

        <ImageButton
            android:id="@+id/btnFullscreen"
            style="@style/BlindCam.ToolButton"
            android:background="@drawable/bg_play_badge"
            android:contentDescription="@string/btn_fullscreen"
            android:tint="#FFFFFF"
            android:src="@drawable/ic_fullscreen" />
    </LinearLayout>

    <!-- ============ 预览区（动态宫格） ============ -->
    <FrameLayout
        android:id="@+id/previewArea"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <GridLayout
            android:id="@+id/gridPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:columnCount="2"
            android:rowCount="2" />

        <!-- 无设备提示 -->
        <TextView
            android:id="@+id/tvEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="@string/no_device"
            android:textColor="#CCFFFFFF"
            android:textSize="17sp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- ============ 底部设备栏 ============ -->
    <HorizontalScrollView
        android:id="@+id/barBottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_glass_bar"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/llDeviceList"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp" />
    </HorizontalScrollView>

</LinearLayout>
